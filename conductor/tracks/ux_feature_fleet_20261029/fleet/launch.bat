@echo off
setlocal enabledelayedexpansion

REM =====================================================================
REM  FLEET LAUNCHER - run all tracks as a ROLLING POOL (single click)
REM  -------------------------------------------------------------------
REM  Generated by the fleet-delegation skill (templates/launch.bat).
REM  Launches reasonix instances so POOL_SIZE (default 6) run
REM  CONCURRENTLY AT ALL TIMES: the first POOL_SIZE tracks launch, then every
REM  time a track finishes the launcher immediately starts the next one in its
REM  place (rolling pool). The slot wait uses wait-recover.ps1 -MaxCount POOL_SIZE,
REM  which returns as soon as a track finishes (a slot frees); a final
REM  wait-recover.ps1 -MaxCount 1 drains the tail (wait until NO instance runs).
REM  Each instance reads its own tracks\track-NN\LAUNCH-PROMPT.md and executes it
REM  end to end (heartbeat / lock / deferral protocol included). Per-track logs
REM  land in logs\track-NN.log.
REM
REM  Prereqs: 'reasonix' on PATH; wait-recover.ps1 next to this file.
REM  Double-click this file from a USER console (never from an orchestrator's
REM  tool session - those processes get reaped by job cleanup).
REM  NEVER kill this fleet from another process; let it finish.
REM =====================================================================

cd /d "%~dp0"

REM ---- config ---------------------------------------------------------
set "TRACKS=%~dp0tracks"
set /a FIRST=0
REM LAST is computed dynamically at :MAIN (re-partition can change the track count)
REM 2026-08-15 (fleet-delegation root-cause fix): raised 400 -> 800 so resume-
REM continuations can finish bookkeeping without pausing again; wait-recover.ps1's
REM -MaxSteps must match this value (launch.bat passes it explicitly).
set "MAX_STEPS=800"
REM Worker tier MUST be set explicitly: per-track sessions run with a unique --dir
REM and do NOT resolve the repo's reasonix.toml default_model (verified: tracks
REM silently ran the heavy default tier instead of the repo's configured flash
REM tier). USER MANDATE (2026-08-15): the fleet runs on Muse Spark 1.2 Contributor
REM (anthropic-api-meta-ai/muse-spark-1.2-contributor).
REM USER MANDATE (2026-08-16, AMENDED): Muse Contributor has a 60 req/h rate limit
REM and WILL fail under 16 parallel workers. On an identified Muse failure (HTTP
REM 429 rate limit / 529 overload / provider 5xx / connection timeouts persisting
REM across 2+ attempts) the WORKER persists its state, writes the marker
REM runtime\status\track-NN\model_fallback.json, and exits with the final line
REM MUSE_FALLBACK_REQUESTED. Every launch surface in this file and wait-recover.ps1
REM then relaunches THAT track on the fallback tier below (sticky per track - the
REM marker is never cleared by a worker).
set "MODEL=anthropic-api-meta-ai/muse-spark-1.2-contributor"
set "MODEL_FALLBACK=deepseek-flash/deepseek-v4-flash"
set "WINOPT=/min"
set "POOL_SIZE=6"
REM Fleet workers run permissionless: `C:\luiscla27\projects\dndbeyond-printenhance\reasonix.exe run` defaults to `ask`, and in the
REM minimized background windows nothing answers — every bash/write_file is
REM auto-declined and the tracks stall with zero heartbeats (verified 2026-08-15).
REM USER MANDATE: ALL reasonix instances default to yolo. Explicit flag here +
REM in wait-recover.ps1 + launcher injection (bin/reasonix.js) + config keys
REM (default_tool_approval_mode) — see ~/.reasonix/HOST-ISSUES.md.
set "PERM_ARG=--permission-mode yolo"
REM Per-track session --dir root: OUTSIDE the repo (verified 2026-08-15 — a --dir
REM inside the repo shares the workspace-write serialization and wedges forever on
REM "Another session is writing to this workspace..."; external --dir + --add-dir
REM repo writes concurrently). Per-fleet subfolder keeps multiple fleets isolated.
for %%F in ("%~dp0.") do set "FLEETNAME=%%~nxF"
set "WSROOT=%USERPROFILE%\reasonix-fleet-workspaces\%FLEETNAME%"
set "POLL_SECONDS=30"
set "TIMEOUT_MINUTES=4320"
set "WAIT_PATTERN=%~dp0tracks\track-"
set "TRACK_TIMEOUT=700"
set "PROGRESS_STALL=700"
set "MAX_RECOVERIES=3"
set "TRACKROOT=%~dp0tracks"
set "RUNTIME=%~dp0runtime"
set "LOGDIR=%~dp0logs"
REM ----------------------------------------------------------------------

if defined MODEL (set "MODEL_ARG=--model !MODEL!") else (set "MODEL_ARG=")
REM ---- UNATTENDED-PATH RULE (measured 2026-09-17): a bare `pause` on this path is an
REM      UNBOUNDED block. The operator runs the fleet with stdout+stderr redirected
REM      (`cd /d <fleet> && launch.bat >> logs\launcher.log 2>&1`) precisely so nobody is
REM      watching; on 2026-09-17 the launcher sat at "Presione una tecla para continuar" from
REM      04:07 (>290 min) while `logs/launcher.log` stayed frozen at 04:06:57 - 4 unit-slots
REM      unfinished, machine idle. Every refusal here therefore sleeps a BOUNDED window and
REM      exits non-interactively, and the window uses `ping.exe -n`, NOT `timeout /t`:
REM      measured on this host with stdout REDIRECTED, `timeout.exe /t 5 /nobreak` returned in
REM      12 ms ("Input redirection is not supported") while `ping.exe -n 31` took 30,175 ms.
if not exist "wait-recover.ps1" (
    echo ERROR: wait-recover.ps1 not found next to this file.
    echo [%date% %time%] Preflight failed - no wait-recover.ps1 - NOT starting. Exiting in 30s. 1>&2
    %SystemRoot%\System32\ping.exe -n 31 127.0.0.1 >nul
    exit /b 1
)

:MAIN
REM compute the track count dynamically (re-partition by recover-stuck.py changes it)
set "NTRACKS=0"
for /d %%d in (tracks\track-*) do set /a NTRACKS+=1
set /a LAST=NTRACKS-1
if !LAST! LSS 0 (
    echo ERROR: no track manifests under tracks\. Run partition.py first.
    exit /b 1
)
if !LAST! EQU 0 goto :SINGLE_TRACK_WARN
goto :TRACKS_OK
:SINGLE_TRACK_WARN
echo.
echo WARNING: only 1 track (0..0) detected - expected more.
echo If this is NOT a recovery re-partition by recover-stuck.py, the partition
echo may have collapsed - check partition.py --tracks N and units.json before launching.
echo.
:TRACKS_OK

REM ---- logs MUST be a directory: a stray 0-byte file named "logs" makes every
REM       per-track redirection (logs\track-NN.log / .launch.txt) fail with
REM       "The system cannot find the path specified." and no worker ever boots.
REM       NOTE: `if exist "logs\"` (trailing backslash) does NOT match a dir on this
REM       cmd — use the "logs\." form, which is the reliable directory test. ----
if exist "logs" (
    if not exist "logs\." (
        echo [launch] removing stray file "logs" and creating the logs directory...
        del /q "logs" >nul 2>&1
    )
)
if not exist "logs\." mkdir "logs"

echo ============================================================
echo   FLEET - rolling pool of %POOL_SIZE% concurrent tracks !FIRST!..!LAST!
echo   max-steps=!MAX_STEPS!   window=!WINOPT!
echo ============================================================
echo.

REM ---- double-launch guard: refuse to start a SECOND fleet over the same runtime ----
for /f %%c in ('powershell -NoProfile -ExecutionPolicy Bypass -File guard.ps1 -Pattern "%WAIT_PATTERN%"') do set "LIVE=%%c"
if defined LIVE if !LIVE! GTR 0 (
    echo ERROR: !LIVE! fleet instances already running ^(%WAIT_PATTERN%^).
    echo This fleet may have been launched already. Do NOT double-start it.
    echo Re-attach the supervisor instead:  powershell -File wait-recover.ps1 -MaxCount 1
    REM exit code 2 is DISTINCT from the preflight's 1 on purpose: an outer wrapper can be
    REM configured to retry only on 1, so this refusal can never amplify into a relaunch loop.
    echo [%date% %time%] Guard refused - fleet already running. NOT double-starting. Exiting in 30s. 1>&2
    %SystemRoot%\System32\ping.exe -n 31 127.0.0.1 >nul
    exit /b 2
)

set /a LAUNCHED=0

REM ---- bottlenecks cop (9th agent, non-track supervisor): starts alongside the pool ----
REM Audits all running tracks once per hour; challenges every fix suggestion >=4 times
REM with a separate Muse instance; on SIGNIFICANT improvements edits the fleet's
REM future-run task files and Telegram-notifies the user to relaunch. It spawns
REM sessions whose task references bottleneck-cop-prompt.md (NOT LAUNCH-PROMPT.md), so
REM the guard + watchdog never count/recover it. It exits on its own when the fleet drains.
start "cop" !WINOPT! cmd /c "powershell -NoProfile -ExecutionPolicy Bypass -File bottleneck_cop.ps1 -FleetDir %~dp0 -FirstCheckMinutes 5 -CycleMinutes 60 1>logs\cop.launch.log 2>&1"

for /L %%i in (!FIRST!,1,!LAST!) do (
    REM pool full? wait for a track to finish, then the next one takes its place
    if !LAUNCHED! GEQ %POOL_SIZE% (
        echo.
        echo [pool] !LAUNCHED! launched; %POOL_SIZE% slots full - waiting for a track to finish...
        call :WAIT_SLOT
    )
    set "ID=00%%i"
    set "ID=!ID:~-2!"
    REM Session --dir lives OUTSIDE the repo (see WSROOT above); the task text still
    REM points at the real LAUNCH-PROMPT.md under fleet\tracks\track-!ID!.
    set "WSDIR=!WSROOT!\track-!ID!"
    if not exist "!WSDIR!" mkdir "!WSDIR!"
    set "TASK=Execute the file !TRACKS!\track-!ID!\LAUNCH-PROMPT.md as your complete task. Read it fully and follow every instruction exactly, including the heartbeat, lock, and deferral protocol it references."
    if exist "!RUNTIME!\status\track-!ID!\model_fallback.json" (
        set "MARG=--model !MODEL_FALLBACK!"
        echo [launch] track-!ID! on FALLBACK model !MODEL_FALLBACK! - marker present
    ) else (
        set "MARG=!MODEL_ARG!"
    )
    start "track-!ID!" !WINOPT! cmd /c "C:\luiscla27\projects\dndbeyond-printenhance\reasonix.exe run --dir !WSDIR! --add-dir C:\luiscla27\projects\dndbeyond-printenhance\conductor\tracks\ux_feature_fleet_20261029\fleet --add-dir C:\luiscla27\projects\dndbeyond-printenhance !MARG! !PERM_ARG! --max-steps !MAX_STEPS! ""!TASK!"" 1>logs\track-!ID!.log 2>&1"
    REM stagger launches so instances don't collide on the shared Reasonix session dir at startup
    %SystemRoot%\System32\ping.exe -n 4 127.0.0.1 >nul
    set /a LAUNCHED+=1
    if !LAUNCHED! EQU %POOL_SIZE% (
        echo.
        echo [pool] first %POOL_SIZE% tracks launched; verifying they booted...
        call :VERIFY_RETRY
    )
)

echo.
echo [pool] all !LAUNCHED! tracks launched; final startup check, then draining the tail...
call :VERIFY_RETRY
call :WAIT_DRAIN
set "DRAIN_RC=!errorlevel!"

echo.
echo [validate] checking for stuck tracks (data inconsistency)...
python recover-stuck.py
if errorlevel 1 (
    echo.
    echo [recover] stuck tracks detected - cleaned stray dirs and re-partitioned the unfinished units. Re-running...
    goto :MAIN
)

REM ---- COMPLETION GATE (F-A, 2026-09-17) -------------------------------------------------
REM `FLEET COMPLETE` used to be printed UNCONDITIONALLY, so a run that drained on a TIMEOUT
REM with 4 of 11 unit-slots unfinished still declared success - measured twice, in opposite
REM directions: run #1 printed the success line at 04:06:57 with 4 units open (track-00 1/2,
REM track-01 1/2, track-03 1/2, track-05 0/1), and run #2 ran a full second pool launch and
REM wrote 0 new unit records. The success line is now gated on an INDEPENDENT artifact -
REM `reconcile.py --check`, the fleet's own integration criterion - and on the drain verdict,
REM which :WAIT_DRAIN now propagates instead of discarding.
set "NOT_COMPLETE="
if !DRAIN_RC! NEQ 0 set "NOT_COMPLETE=1"
if exist reconcile.py (
    python reconcile.py --check
    if errorlevel 1 set "NOT_COMPLETE=1"
) else (
    echo [validate] reconcile.py is missing - the completion criterion CANNOT be evaluated,
    echo [validate] so this run refuses the success line rather than guessing (fail closed).
    set "NOT_COMPLETE=1"
)
if defined NOT_COMPLETE (
    echo.
    echo FLEET NOT COMPLETE - refusing the success line.
    echo   drain exit code !DRAIN_RC! ^(0 = drained clean, 1 = TIMEOUT^)
    if !DRAIN_RC! NEQ 0 echo   the pool drained on a TIMEOUT - some instances may be stuck.
    echo   the reconcile census above IS the criterion: every unit must be done-recorded.
    echo   Re-run launch.bat to resume the unfinished units, or inspect with: python reconcile.py
    echo.
    endlocal
    exit /b 3
)

echo.
echo FLEET COMPLETE. All !LAUNCHED! tracks ran with a rolling pool of %POOL_SIZE%.
echo Next: run integrator-prompt.md when every track reports done.
echo.
endlocal
exit /b 0

:VERIFY_RETRY
REM Wait for instances to boot, then relaunch any that hit session contention at startup.
echo [verify] waiting for instances to boot, then checking for startup failures...
%SystemRoot%\System32\ping.exe -n 21 127.0.0.1 >nul
set /a RETRIED=0
for /L %%j in (!FIRST!,1,!LAST!) do (
    set "VID=00%%j"
    set "VID=!VID:~-2!"
    findstr /C:"session is in use" /C:"in use by another" /C:"cleanup stale subagents" logs\track-!VID!.log >nul 2>&1
    if not errorlevel 1 (
        echo [verify] track-!VID! failed at startup - relaunching
        set "VTASK=Execute the file !TRACKS!\track-!VID!\LAUNCH-PROMPT.md as your complete task. Read it fully and follow every instruction exactly, including the heartbeat, lock, and deferral protocol it references."
        if exist "!RUNTIME!\status\track-!VID!\model_fallback.json" (
            set "MARG=--model !MODEL_FALLBACK!"
            echo [verify] track-!VID! on FALLBACK model !MODEL_FALLBACK! - marker present
        ) else (
            set "MARG=!MODEL_ARG!"
        )
        start "track-!VID!" !WINOPT! cmd /c "C:\luiscla27\projects\dndbeyond-printenhance\reasonix.exe run --dir !WSROOT!\track-!VID! --add-dir C:\luiscla27\projects\dndbeyond-printenhance\conductor\tracks\ux_feature_fleet_20261029\fleet --add-dir C:\luiscla27\projects\dndbeyond-printenhance !MARG! !PERM_ARG! --max-steps !MAX_STEPS! ""!VTASK!"" 1>logs\track-!VID!.log 2>&1"
        %SystemRoot%\System32\ping.exe -n 4 127.0.0.1 >nul
        set /a RETRIED+=1
    )
)
if !RETRIED! GTR 0 echo [verify] relaunched !RETRIED! tracks that had failed at startup.
exit /b 0

:WAIT_SLOT
REM Rolling pool: return as soon as fewer than POOL_SIZE instances are running
REM (a track finished -> a slot is free for the next one). The watchdog still
REM applies its AGE + PROGRESS-STALL rules on every poll.
powershell -NoProfile -ExecutionPolicy Bypass -File wait-recover.ps1 -Pattern "%WAIT_PATTERN%" -PollSeconds %POLL_SECONDS% -TimeoutMinutes %TIMEOUT_MINUTES% -TrackTimeoutMinutes %TRACK_TIMEOUT% -ProgressStallMinutes %PROGRESS_STALL% -MaxRecoveries %MAX_RECOVERIES% -MaxCount %POOL_SIZE% -MaxSteps %MAX_STEPS% -TrackRoot "%TRACKROOT%" -Runtime "%RUNTIME%" -LogDir "%LOGDIR%"
if errorlevel 1 (
    echo.
    echo [pool] TIMEOUT while waiting for a slot - some instances may be stuck.
)
exit /b 0

:WAIT_DRAIN
REM Final drain: wait until NO instance is left running (MaxCount 1 = fewer than 1).
powershell -NoProfile -ExecutionPolicy Bypass -File wait-recover.ps1 -Pattern "%WAIT_PATTERN%" -PollSeconds %POLL_SECONDS% -TimeoutMinutes %TIMEOUT_MINUTES% -TrackTimeoutMinutes %TRACK_TIMEOUT% -ProgressStallMinutes %PROGRESS_STALL% -MaxRecoveries %MAX_RECOVERIES% -MaxCount 1 -MaxSteps %MAX_STEPS% -TrackRoot "%TRACKROOT%" -Runtime "%RUNTIME%" -LogDir "%LOGDIR%"
set "DRC=0"
if errorlevel 1 (
    set "DRC=1"
    echo.
    echo [pool] TIMEOUT while draining - some instances may be stuck.
)
REM PROPAGATE the drain verdict (F-A, 2026-09-17): this label used to end in an
REM unconditional `exit /b 0`, so `call :WAIT_DRAIN` DISCARDED whatever the supervisor
REM exited with and the caller could not tell a clean drain from a 125-minute timeout.
REM Measured: two runs hit the SAME `[pool] TIMEOUT while draining` and diverged - one
REM collapsed 7 unfinished units into 1 track, the other printed FLEET COMPLETE.
exit /b !DRC!
